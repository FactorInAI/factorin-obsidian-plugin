{
	"name": "factorin-obsidian",
	"version": "0.1.0",
	"description": "Factor.In Obsidian — the Factor.In plugin for Obsidian, built on a branded fork of the Sync Engine v3 monorepo.",
	"private": true,
	"license": "MIT",
	"workspaces": [
		"./packages/*"
	],
	"type": "module",
	"scripts": {
		"postinstall": "bun --bun turbo run compile -F @hesprs/sync-engine-sdk",
		"dev:plugin": "cd packages/plugin && bun --bun dev:plugin",
		"build:plugin": "cd packages/plugin && bun --bun build:plugin",
		"dev": "bun --bun turbo run dev",
		"compile": "bun --bun turbo run compile",
		"ver": "bun scripts/version-bump.ts",
		"fix": "bun --bun turbo run fix",
		"check": "bun --bun turbo run check",
		"tests": "bun --bun turbo run tests"
	},
	"devDependencies": {
		"@tsdown/css": "^0.22.7",
		"@types/bun": "^1.3.14",
		"obsidian": "latest",
		"oxfmt": "^0.61.0",
		"oxlint": "^1.76.0",
		"oxlint-tsgolint": "^7.0.2001",
		"tsdown": "^0.22.7",
		"turbo": "^2.10.5",
		"typescript": "^7.0.2"
	},
	"packageManager": "bun@1.3.13",
	"factorin": {
		"upstream": {
			"repository": "https://github.com/hesprs/obsidian-webdav-sync",
			"branch": "feat/fs",
			"baseVersion": "3.0.0-beta-18"
		}
	}
}
