{
	"name": "sync-engine",
	"version": "0.0.1",
	"private": true,
	"license": "MIT",
	"workspaces": [
		"./packages/*",
		"./docs"
	],
	"type": "module",
	"scripts": {
		"dev:plugin": "cd packages/plugin && bun --bun dev:plugin",
		"build:plugin": "cd packages/plugin && bun --bun build:plugin",
		"dev:docs": "cd docs && bun --bun dev:docs",
		"build:docs": "cd docs && bun --bun build:docs",
		"dev": "bun --bun turbo run dev",
		"build": "bun --bun turbo run build",
		"ver": "bun scripts/version-bump.ts",
		"fix": "bun --bun turbo run fix",
		"check": "bun --bun turbo run check",
		"tests": "bun --bun turbo run tests"
	},
	"devDependencies": {
		"@tsdown/css": "^0.22.7",
		"@types/bun": "^1.3.14",
		"obsidian": "latest",
		"oxfmt": "^0.58.0",
		"oxlint": "^1.73.0",
		"oxlint-tsgolint": "^0.24.0",
		"tsdown": "^0.22.7",
		"turbo": "^2.10.5",
		"typescript": "^7.0.2"
	},
	"packageManager": "bun@1.3.13"
}
