{
	"name": "@hesprs/sync-engine-sdk",
	"version": "3.0.0",
	"keywords": [
		"obsidian-plugin",
		"sdk",
		"synchronization"
	],
	"homepage": "https://sync.consensia.cc",
	"bugs": {
		"url": "https://github.com/hesprs/sync-engine/issues"
	},
	"license": "MIT",
	"author": {
		"name": "Hēsperus",
		"email": "hesprs@outlook.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hesprs/sync-engine.git"
	},
	"files": [
		"./dist"
	],
	"type": "module",
	"sideEffects": false,
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./dev": {
			"types": "./dist/dev.d.ts",
			"default": "./dist/dev.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev:plugin": "MODE=dev BUILD=plugin tsdown",
		"build:plugin": "BUILD=plugin tsdown",
		"dev": "MODE=dev tsdown",
		"build": "tsdown",
		"fix": "oxlint --silent --fix --type-aware && oxfmt",
		"check": "tsc && oxlint --type-aware && oxfmt --check",
		"tests": "bun --preload=./test/mocks test"
	},
	"dependencies": {
		"obsidian": "latest"
	},
	"devDependencies": {
		"@repo/shared": "workspace:*",
		"@types/glob-to-regexp": "^0.4.4",
		"@unocss/postcss": "66.7.5",
		"glob-to-regexp": "^0.4.1",
		"postcss-merge-rules": "^8.0.1",
		"solid-js": "^1.9.13",
		"synthkernel": "./synthkernel.tgz",
		"uni-kv": "../../uni-kv.tgz",
		"unocss": "66.7.5",
		"unplugin-solid": "^2.0.0"
	}
}
