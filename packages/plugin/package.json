{
	"name": "@hesprs/sync-engine-sdk",
	"version": "3.0.0",
	"license": "MIT",
	"files": [
		"./dist-sdk"
	],
	"type": "module",
	"types": "./dist-sdk/index.d.ts",
	"exports": {
		".": {
			"types": "./dist-sdk/index.d.ts",
			"default": "./dist-sdk/index.js"
		},
		"./dev": {
			"types": "./dist-sdk/dev.d.ts",
			"default": "./dist-sdk/dev.js"
		}
	},
	"scripts": {
		"dev": "MODE=dev BUILD=plugin tsdown && MODE=dev BUILD=sdk tsdown",
		"build": "BUILD=plugin tsdown && BUILD=sdk tsdown",
		"lint": "oxlint --fix --silent --type-aware && oxfmt",
		"check": "tsc && oxlint --format agent --type-aware && oxfmt --check",
		"tests": "bun --preload=./test/mocks test"
	},
	"dependencies": {
		"obsidian": "latest"
	},
	"devDependencies": {
		"@repo/shared": "workspace:*",
		"@types/glob-to-regexp": "^0.4.4",
		"@unocss/postcss": "66.7.2",
		"glob-to-regexp": "^0.4.1",
		"postcss-merge-rules": "^8.0.1",
		"solid-js": "^1.9.13",
		"synthkernel": "./synthkernel.tgz",
		"uni-kv": "../../uni-kv.tgz",
		"unocss": "66.7.2",
		"unplugin-solid": "^1.0.0"
	}
}
