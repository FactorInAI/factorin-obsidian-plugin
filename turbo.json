{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "stream",
	"noUpdateNotifier": true,
	"concurrency": "100%",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"],
			"cache": true
		},
		"dev": {
			"dependsOn": ["^dev"],
			"outputs": ["dist/**"],
			"cache": true
		},
		"fix": {
			"dependsOn": [],
			"cache": true
		},
		"check": {
			"cache": true,
			"dependsOn": ["dev", "^dev"]
		},
		"tests": {
			"dependsOn": ["^dev"],
			"cache": true
		}
	}
}
